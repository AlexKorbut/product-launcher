# Copy to .env and fill in. .env is gitignored at the repo root.

# --- LLM (Anthropic Claude) ---
ANTHROPIC_API_KEY=

# --- Embeddings (Voyage AI, multilingual) ---
VOYAGE_API_KEY=

# --- Database (Postgres + pgvector) ---
# Optional: if unset, the app falls back to local SQLite at .data/morning_paper.db
MP_DB_URL=postgresql+psycopg://morning:morning@localhost:5432/morning_paper

# --- Object store (local dir in dev, or s3://bucket/prefix) ---
MP_OBJECT_STORE_URL=file://./.data/objects

# --- Async workers (Celery). Leave empty to run issues in-process (dev). ---
# Start redis with: docker compose --profile workers up -d redis
MP_BROKER_URL=
MP_RESULT_BACKEND=

# --- Live Telegram source (Telethon, per-user) — get these at https://my.telegram.org ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- News candidate APIs (optional) ---
NEWSAPI_KEY=

# --- Delivery ---
TELEGRAM_BOT_TOKEN=
RESEND_API_KEY=
