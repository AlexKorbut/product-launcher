{
  "name": "payoutproof",
  "version": "0.1.0",
  "private": true,
  "description": "PayoutProof — TikTok Shop payout audit: find the money TikTok Shop owes you",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
