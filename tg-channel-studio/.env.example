# --- Core ---
SECRET_KEY=generate-a-long-random-string        # JWT + шифрование bot-токенов
POSTGRES_PASSWORD=studio
DATABASE_URL=postgresql+asyncpg://studio:studio@localhost:5432/studio
PUBLIC_BASE_URL=http://localhost:3000            # для реферальных ссылок и redirect Stripe
CORS_ORIGINS=*                                   # в проде: https://app.your-domain.com

# --- Маркетинг-сайт ---
SITE_URL=http://localhost:3001
APP_URL=http://localhost:3000

# --- Кредиты / экономика ---
SIGNUP_BONUS_CREDITS=500
REFERRAL_BONUS_CREDITS=300
CREDIT_PRICE_USD=0.01
GENERATION_MARKUP=3.0

# --- Генерация: выбор LLM-провайдера ---
# anthropic | openai (OpenAI-совместимый: OpenRouter / DeepSeek / Together / локальный)
# Можно переопределить на каждый канал в UI.
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
GENERATION_MODEL=claude-opus-4-8
PRICE_INPUT_PER_MTOK=5.00
PRICE_OUTPUT_PER_MTOK=25.00

# OpenAI-совместимый (OPENAI_BASE_URL пусто = api.openai.com)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o
OPENAI_PRICE_INPUT_PER_MTOK=2.50
OPENAI_PRICE_OUTPUT_PER_MTOK=10.00

# --- Stripe (биллинг кредитов) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Соответствие Stripe Price ID -> кол-во кредитов (JSON):
STRIPE_PRICE_CREDITS={"price_xxx_5000":5000,"price_xxx_20000":20000}

# --- Telegram userbot (чтение доноров, MTProto) ---
# Получи на https://my.telegram.org -> API development tools
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELETHON_SESSION=userbot

# --- Анти-плагиат ---
MAX_REWRITE_SIMILARITY=0.75

# --- Опционально ---
REDIS_URL=redis://localhost:6379/0
SENTRY_DSN=
